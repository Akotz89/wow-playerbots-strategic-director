{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.playerbots.invalid/schemas/gear-plan-v1.schema.json",
  "title": "Playerbots earned gearing plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "character_id",
    "content_revision",
    "content_graph_digest",
    "policy_version",
    "policy_identity",
    "created_at_seconds",
    "selected_target_id",
    "selected_source_id",
    "selected_item_id",
    "evaluations",
    "targets",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "cpi-207-gear-plan-v1"
    },
    "plan_id": {
      "$ref": "common-v1.schema.json#/$defs/stable_id"
    },
    "character_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "content_revision": {
      "$ref": "common-v1.schema.json#/$defs/revision"
    },
    "content_graph_digest": {
      "$ref": "common-v1.schema.json#/$defs/digest"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "policy_identity": {
      "type": "string",
      "minLength": 1
    },
    "created_at_seconds": {
      "$ref": "common-v1.schema.json#/$defs/timestamp"
    },
    "selected_target_id": {
      "anyOf": [
        {
          "$ref": "common-v1.schema.json#/$defs/stable_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "selected_source_id": {
      "anyOf": [
        {
          "$ref": "common-v1.schema.json#/$defs/stable_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "selected_item_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluations": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "source_id",
          "item_id",
          "eligible",
          "disposition",
          "reason_codes",
          "score"
        ],
        "properties": {
          "target_id": {
            "$ref": "common-v1.schema.json#/$defs/stable_id"
          },
          "source_id": {
            "$ref": "common-v1.schema.json#/$defs/stable_id"
          },
          "item_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "eligible": {
            "type": "boolean"
          },
          "disposition": {
            "enum": [
              "pursue",
              "deferred",
              "abandoned"
            ]
          },
          "reason_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*(:[a-zA-Z0-9_.:-]+)?$",
              "maxLength": 240
            }
          },
          "score": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "upgrade_utility",
              "useful_life",
              "profession",
              "acquisition_time",
              "money",
              "risk",
              "contention",
              "total",
              "expected_attempts_numerator",
              "expected_attempts_denominator",
              "expected_attempts_ceiling",
              "expected_acquisition_seconds"
            ],
            "properties": {
              "upgrade_utility": {
                "type": "integer",
                "minimum": -9223372036854775808,
                "maximum": 9223372036854775807
              },
              "useful_life": {
                "type": "integer",
                "minimum": -9223372036854775808,
                "maximum": 9223372036854775807
              },
              "profession": {
                "type": "integer",
                "minimum": -9223372036854775808,
                "maximum": 9223372036854775807
              },
              "acquisition_time": {
                "type": "integer",
                "minimum": -9223372036854775808,
                "maximum": 9223372036854775807
              },
              "money": {
                "type": "integer",
                "minimum": -9223372036854775808,
                "maximum": 9223372036854775807
              },
              "risk": {
                "type": "integer",
                "minimum": -9223372036854775808,
                "maximum": 9223372036854775807
              },
              "contention": {
                "type": "integer",
                "minimum": -9223372036854775808,
                "maximum": 9223372036854775807
              },
              "total": {
                "type": "integer",
                "minimum": -9223372036854775808,
                "maximum": 9223372036854775807
              },
              "expected_attempts_numerator": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "expected_attempts_denominator": {
                "type": "integer",
                "minimum": 1,
                "maximum": 18446744073709551615
              },
              "expected_attempts_ceiling": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "expected_acquisition_seconds": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              }
            }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "slot",
          "item_id",
          "playerbots_upgrade_score",
          "expected_replacement_level",
          "profession_value",
          "status",
          "reason_codes"
        ],
        "properties": {
          "target_id": {
            "type": "string"
          },
          "slot": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "item_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "playerbots_upgrade_score": {
            "type": "integer",
            "minimum": -9223372036854775808,
            "maximum": 9223372036854775807
          },
          "expected_replacement_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "profession_value": {
            "type": "integer",
            "minimum": -9223372036854775808,
            "maximum": 9223372036854775807
          },
          "status": {
            "enum": [
              "candidate",
              "invalid",
              "unavailable"
            ]
          },
          "reason_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*(:[a-zA-Z0-9_.:-]+)?$",
              "maxLength": 240
            }
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]*(:[a-zA-Z0-9_.:-]+)?$",
        "maxLength": 240
      }
    }
  }
}
